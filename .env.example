# Project Acrux — local environment template.
# Copy to ".env" (Copy-Item .env.example .env) and fill in only what you need.
# Every key is OPTIONAL: the app starts without them and shows "not configured"
# for any source that needs one. Never commit your real .env file.

# --- NASA API key (api.nasa.gov). Optional: falls back to the heavily rate-limited DEMO_KEY.
NASA_API_KEY=your_nasa_api_key_here

# --- NASA FIRMS MAP_KEY (wildfire hotspots). Required for the Wildfire module.
# Request one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# --- OpenRouter (AI assistant). Backend-only; never exposed to the browser.
OPENROUTER_API_KEY=your_openrouter_API_key_here
# Use a current model id from https://openrouter.ai/models (not hardcoded by the app).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Project Acrux

# --- Supabase (OPTIONAL persistence for saved locations, reports and simulation runs).
# Backend-only. Use the SERVICE/secret key, never the public anon/publishable key, and never
# put either in the frontend. Run docs/supabase/schema.sql in your project first.
# For a fully local database use the Supabase CLI (`supabase start`, needs Docker) and
# SUPABASE_URL=http://127.0.0.1:54321. A cloud project stores your data on Supabase's servers.
SUPABASE_URL=https://dqlrnstyvyrxovdvozji.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# --- Local server settings
# Comma-separated list of browser origins allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Outbound HTTP timeout (seconds) for third-party APIs.
HTTP_TIMEOUT_SECONDS=20