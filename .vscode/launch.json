{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Acrux: Debug backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Acrux: Open frontend in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Acrux: Full stack (debug backend + browser)",
      "configurations": ["Acrux: Debug backend (FastAPI)", "Acrux: Open frontend in Chrome"],
      "preLaunchTask": "Acrux: Frontend",
      "stopAll": true
    }
  ]
}
